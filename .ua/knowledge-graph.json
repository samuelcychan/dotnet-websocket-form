      ]
    },
    {
      "id": "layer:project-support",
      "name": "Project Support",
      "description": "Solution-wide build settings, usage and contributor documentation, and knowledge-graph language configuration support development of the library and Windows monitor.",
      "nodeIds": [
        "config:.ua/config.json",
