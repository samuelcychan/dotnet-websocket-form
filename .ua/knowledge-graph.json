  "tour": [
    {
      "order": 1,
      "title": "Start The Desktop Monitor",
      "description": "Begin at Program.cs, which initializes Windows Forms and starts MainForm on an STA thread. The README explains the purpose: a public Binance market-data monitor backed by an independent .NET 10 streaming library. The monitor project targets Windows and copies the sample recording into its output.",
      "nodeIds": [
        "file:src/BinanceMonitor/Program.cs",
        "document:README.md",
        "config:src/BinanceMonitor/BinanceMonitor.csproj"
      ]
    },
    {
      "order": 2,
      "title": "Choose And Validate Subscriptions",
      "description": "MainForm turns symbol and stream selections into subscriptions when a session starts. Subscription validates alphanumeric symbols, normalizes their case, and formats the case-sensitive stream suffix for trades, aggregate trades, or best quotes. This boundary rejects invalid requests before the network connection begins.",
      "nodeIds": [
        "file:src/BinanceMonitor/MainForm.cs",
        "file:src/BinanceStream/Subscription.cs"
      ]
    },
    {
      "order": 3,
      "title": "Follow The Live Connection",
      "description": "BinanceClient consumes the validated subscriptions and connects ClientWebSocket to the combined public stream endpoint. Each enumeration owns its socket, assembles bounded text messages, and reconnects with exponential backoff and jitter after connection failures. Cancellation ends the session and releases its connection.",
      "nodeIds": [
        "file:src/BinanceStream/BinanceClient.cs"
      ],
      "languageLesson": "C# async streams expose IAsyncEnumerable<T>: await foreach processes yielded events incrementally while cancellation can interrupt asynchronous work."
    },
    {
      "order": 4,
      "title": "Convert Messages Into Events",
      "description": "The live connection passes complete JSON messages to MarketEventParser. It unwraps combined payloads and creates immutable Trade, BookTicker, or UnknownEvent records, giving downstream consumers one typed event vocabulary. Invariant decimal conversion preserves price and quantity values independently of the machine's locale.",
      "nodeIds": [
        "file:src/BinanceStream/MarketEvent.cs"
      ],
      "languageLesson": "C# records provide value-oriented immutable models, while decimal is suitable for representing the decimal prices and quantities delivered in these payloads."
    },
    {
      "order": 5,
      "title": "Render A Bounded View",
      "description": "Return to MainForm to see how parsed events cross from background consumption to the UI timer. The monitor holds up to 1,000 pending events, renders up to 100 per tick, and retains 500 grid rows; older pending events can be dropped, so this view is not a complete recorder. Closing cancels and awaits the active session before disposing the timer.",
      "nodeIds": [
        "file:src/BinanceMonitor/MainForm.cs",
        "function:src/BinanceMonitor/MainForm.cs:RenderPending",
        "function:src/BinanceMonitor/MainForm.cs:OnClosing"
      ]
    },
    {
      "order": 6,
      "title": "Replay Without The Network",
      "description": "The same monitor can consume FileReplay instead of the live client. It reads nonblank JSONL records in order, uses the same parser, and inserts a cancellable fixed delay between records. The three sample messages exercise trade, aggregate-trade, and best-quote displays without contacting Binance.",
      "nodeIds": [
        "file:src/BinanceStream/FileReplay.cs",
        "file:samples/market.jsonl"
      ]
    },
    {
      "order": 7,
      "title": "Build And Verify Changes",
      "description": "Finish with the solution and contributor guide to build using dotnet build BinanceStream.slnx -c Release. Run dotnet run --project tests/BinanceStream.Tests -c Release for eight offline checks covering parsing, decimal precision, subscriptions, replay, and cancellation; add -- --live for the optional 30-second connection smoke test. Shared build settings enable nullable references and warnings as errors, while transport failure and UI lifecycle behavior need additional validation beyond these checks.",
      "nodeIds": [
        "file:BinanceStream.slnx",
        "file:Directory.Build.props",
        "document:AGENTS.md",
        "file:tests/BinanceStream.Tests/Program.cs",
        "config:tests/BinanceStream.Tests/BinanceStream.Tests.csproj"
      ]
    }
  ]
