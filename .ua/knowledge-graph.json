  "layers": [
    {
      "id": "layer:desktop-monitor",
      "name": "Desktop Monitor",
      "description": "Windows Forms entry point and monitor manage live or replay sessions, bounded event buffering, UI updates, and cancellation during shutdown.",
      "nodeIds": [
        "config:src/BinanceMonitor/BinanceMonitor.csproj",
        "file:src/BinanceMonitor/MainForm.cs",
        "file:src/BinanceMonitor/Program.cs"
      ]
    },
    {
      "id": "layer:market-streaming",
      "name": "Market Streaming Library",
      "description": "The reusable .NET 10 library validates subscriptions, streams public Binance trades and best quotes with reconnection, parses immutable events, and replays JSONL records.",
      "nodeIds": [
        "file:src/BinanceStream/BinanceClient.cs",
        "config:src/BinanceStream/BinanceStream.csproj",
        "file:src/BinanceStream/FileReplay.cs",
        "file:src/BinanceStream/MarketEvent.cs",
        "file:src/BinanceStream/Subscription.cs"
      ]
    },
    {
      "id": "layer:validation-samples",
      "name": "Regression Checks And Samples",
      "description": "The console harness checks parsing, precision, subscriptions, replay, and cancellation with an optional live smoke test, while recorded market messages support offline monitor playback.",
      "nodeIds": [
        "file:samples/market.jsonl",
        "config:tests/BinanceStream.Tests/BinanceStream.Tests.csproj",
